# Copy to .env for local development. Never commit real credentials.
OPENAI_API_KEY=
GEMINI_API_KEY=
APP_ENVIRONMENT=development
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash,gemini-3.7-flash
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
DATABASE_URL=postgresql+psycopg://requirements:requirements@127.0.0.1:5433/requirements_db
CHROMA_PERSIST_DIRECTORY=backend/data/chroma
CHROMA_COLLECTION_NAME=requirements_documents
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_SIZE_MB=20
